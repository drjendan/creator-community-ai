NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# development, preview, staging, or production. Set explicitly in hosted environments.
APP_ENV=development
# 32-byte key encoded as base64 or 64 hexadecimal characters.
# Generate once and keep it server-side; changing it makes stored provider keys unreadable.
APP_ENCRYPTION_KEY=
# Optional dedicated HMAC secret for privacy-safe abuse-control identifiers.
# When omitted, APP_ENCRYPTION_KEY is used. Configure one before production.
RATE_LIMIT_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=upnexx.net
# Exact production hostname accepted by the hosting provider for custom-domain CNAME records.
CUSTOM_DOMAIN_CNAME_TARGET=app.upnexx.net
# Keep false until live Stripe credentials, Prices, webhooks, Connect, and transaction validation are complete.
STRIPE_BILLING_ENABLED=false
STRIPE_PLATFORM_BILLING_ENABLED=false
STRIPE_CONNECT_ENABLED=false
LIVE_CHECKOUT_ENABLED=false
TENANT_PAID_MEMBERSHIPS_ENABLED=false
TENANT_PRODUCT_PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Connect webhook signing secret for account, checkout, subscription, and invoice events.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Standard-account OAuth client ID and a random state-signing secret (32+ characters).
STRIPE_CONNECT_CLIENT_ID=
STRIPE_CONNECT_STATE_SECRET=
# UpNexx application fee in basis points (for example, 500 = 5%). Paid
# publishing remains disabled when this is empty or zero.
STRIPE_PLATFORM_FEE_BPS=
# Enable only after wildcard DNS and the Vercel wildcard domain are verified.
TENANT_SUBDOMAINS_ENABLED=false
# Communication Hub server-only secrets.
# Generate a random value of at least 32 characters for signed preference links.
COMMUNICATION_SIGNING_SECRET=
# Copied from the tenant-neutral Resend webhook configuration in the Resend dashboard.
RESEND_WEBHOOK_SECRET=
# Platform fallback for transactional team invitations when a tenant has not
# connected a verified Resend provider and the recipient already has an account.
PLATFORM_RESEND_API_KEY=
PLATFORM_INVITATION_FROM_EMAIL=
PLATFORM_INVITATION_FROM_NAME=UpNexx
# Invitation links default to seven days. Valid application values are 1-30.
INVITATION_EXPIRATION_DAYS=7
# Platform Resend fallback for tenant Communication Hub sends.
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@upnexx.net
# Used by Vercel Cron to authorize scheduled communication processing.
CRON_SECRET=
